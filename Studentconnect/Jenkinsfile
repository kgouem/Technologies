
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }

    stages {
        stage('Verify Environment') {
            steps {
                sh 'node --version'
                sh 'npm --version'
            }
        }

        stage('Install Backend Dependencies') {
            steps {
                dir('Studentconnect/backend') {
                    sh 'npm ci'
                }
            }
        }

stage('Test Backend API') {
    steps {
        dir('Studentconnect/backend') {
            sh 'npm test'
        }
    }
}

        stage('Install Frontend Dependencies') {
            steps {
                dir('Studentconnect/frontend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Build React Frontend') {
            steps {
                dir('Studentconnect/frontend') {
                    sh 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo 'StudentConnect CI build completed successfully!'
        }
        failure {
            echo 'StudentConnect CI build failed. Check console output.'
        }
    }
}
